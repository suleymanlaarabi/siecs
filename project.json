{
  "id": "siecs",
  "type": "package",
  "value": {
    "author": "Suleyman Laarabi",
    "description": "Small ECS library",
    "clangd": true,
    "use": ["sireflect", "sijson", "sihttp"]
  },
  "lang.c": {
    "c-standard": "c23",
    "cpp-standard": "c++23",
    "export-symbols": true,
    "include": ["src"],
    "${os linux}": {
      "lib": ["pthread"],
      "${cfg debug}": {
        "export-symbols": true
      },
      "cflags": ["-D_POSIX_C_SOURCE=200809L"],
      "${cfg sanitize}": {
        "export-symbols": true
      }
    },
    "cflags": ["-DSIECS_REST"]
  },
  "bundle": {
    "repositories": {
      "sireflect": "https://github.com/suleymanlaarabi/sireflect",
      "sijson": "https://github.com/suleymanlaarabi/sijson",
      "sihttp": "https://github.com/suleymanlaarabi/sihttp"
    }
  }
}
