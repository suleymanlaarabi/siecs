{
  "id": "siecs",
  "type": "package",
  "value": {
    "author": "Suleyman Laarabi",
    "description": "Small ECS library",
    "public": true,
    "clangd": true,
    "use": ["sicore", "sireflect", "sijson"],
    "amalgamate": [
      {
        "path": "distr",
        "dependencies": true
      }
    ]
  },
  "lang.c": {
    "c-standard": "c17",
    "cpp-standard": "c++20",
    "export-symbols": true,
    "include": ["src"],
    "${os linux}": {
      "lib": ["pthread"],
      "${cfg debug}": {
        "export-symbols": true
      },
      "cflags": ["-D_POSIX_C_SOURCE=200809L"],
      "${cfg sanitize}": {
        "export-symbols": true
      }
    },
    "${os windows}": {
      "cflags": ["/experimental:c11atomics"]
    }
  },
  "bundle": {
    "repositories": {
      "sireflect": "https://github.com/suleymanlaarabi/sireflect",
      "sijson": "https://github.com/suleymanlaarabi/sijson",
      "sicore":  "https://github.com/suleymanlaarabi/sicore"
    },
    "refs": {
      "default": {
        "sicore": { "branch": "main", "commit": "815a938a1ee7ec30469b898b4e34b494930f618b" },
        "sireflect": { "branch": "main", "commit": "6b38365a7aa91ca960299a189261fe5e827cdb52" },
        "sijson": { "branch": "main", "commit": "55a9780d3cbdf7911ac4c74d7e3c28a78f553180" }
      }
    }
  }
}
