{
  "id": "siecs",
  "type": "package",
  "value": {
    "author": "Suleyman Laarabi",
    "description": "Small ECS library",
    "public": true,
    "clangd": true,
    "use": ["sicore", "sireflect", "sijson"],
    "amalgamate": [
      {
        "path": "distr",
        "dependencies": true
      }
    ]
  },
  "lang.c": {
    "c-standard": "c17",
    "cpp-standard": "c++20",
    "export-symbols": true,
    "include": ["src"],
    "${os linux}": {
      "lib": ["pthread"],
      "${cfg debug}": {
        "export-symbols": true
      },
      "cflags": ["-D_POSIX_C_SOURCE=200809L"],
      "${cfg sanitize}": {
        "export-symbols": true
      }
    }
  },
  "bundle": {
    "repositories": {
      "sireflect": "https://github.com/suleymanlaarabi/sireflect",
      "sijson": "https://github.com/suleymanlaarabi/sijson",
      "sicore":  "https://github.com/suleymanlaarabi/sicore"
    },
    "refs": {
      "default": {
        "sicore": { "branch": "main", "commit": "815a938a1ee7ec30469b898b4e34b494930f618b" },
        "sireflect": { "branch": "main", "commit": "f79f3e28b8243918061ad5b6b44fc698842ed4b5" },
        "sijson": { "branch": "main", "commit": "7c978e7eaf821d0ce13af4ed96ef1e7d7e3eec62" }
      }
    }
  }
}
