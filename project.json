{
  "id": "siecs",
  "type": "package",
  "value": {
    "author": "Suleyman Laarabi",
    "description": "Small ECS library",
    "clangd": true,
    "amalgamate": [
      {
        "path": "distr"
      }
    ],
    "use": ["sireflect"]
  },
  "lang.c": {
    "c-standard": "c23",
    "export-symbols": true,
    "include": ["src"]
  },
  "bundle": {
    "repositories": {
      "sireflect": "https://github.com/suleymanlaarabi/sireflect"
    }
  }
}
