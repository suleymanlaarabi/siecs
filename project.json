{
  "id": "siecs",
  "type": "package",
  "value": {
    "author": "Suleyman Laarabi",
    "description": "Small ECS library",
    "public": true,
    "clangd": true,
    "use": ["sicore", "sireflect", "sijson"],
    "amalgamate": [
      {
        "path": "distr",
        "dependencies": true
      }
    ]
  },
  "lang.c": {
    "c-standard": "c17",
    "cpp-standard": "c++20",
    "export-symbols": true,
    "include": ["src"],
    "${os linux}": {
      "lib": ["pthread", "dl"],
      "${cfg debug}": {
        "export-symbols": true
      },
      "cflags": ["-D_POSIX_C_SOURCE=200809L"],
      "${cfg sanitize}": {
        "export-symbols": true
      }
    },
    "${os windows}": {
      "cflags": ["/experimental:c11atomics"]
    }
  },
  "bundle": {
    "repositories": {
      "sireflect": "https://github.com/suleymanlaarabi/sireflect",
      "sijson": "https://github.com/suleymanlaarabi/sijson",
      "sicore":  "https://github.com/suleymanlaarabi/sicore"
    }
  }
}
