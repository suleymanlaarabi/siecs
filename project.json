{
  "id": "siecs",
  "type": "package",
  "value": {
    "author": "Suleyman Laarabi",
    "description": "Small ECS library",
    "public": true,
    "clangd": true,
    "use": ["sicore", "sireflect", "sijson", "sihttp"],
    "amalgamate": [
      {
        "path": "distr",
        "dependencies": [
          {
            "when": "SICORE_VEC",
            "use": ["sicore"]
          },
          {
            "when": "SIECS_HAS_META",
            "use": ["sireflect", "sijson"]
          },
          {
            "when": "SIECS_HAS_REST",
            "use": ["sihttp"]
          }
        ]
      },
      {
        "path": "distr",
        "prefix": "siecs_no_addons",
        "disable-flags": [
          "SIECS_HAS_META",
          "SIECS_HAS_REST"
        ],
        "dependencies": [
          {
            "when": "SICORE_VEC",
            "use": ["sicore"]
          },
          {
            "when": "SIECS_HAS_META",
            "use": ["sireflect", "sijson"]
          },
          {
            "when": "SIECS_HAS_REST",
            "use": ["sihttp"]
          }
        ]
      }
    ]
  },
  "lang.c": {
    "c-standard": "c23",
    "cpp-standard": "c++23",
    "export-symbols": true,
    "include": ["src"],
    "${os linux}": {
      "lib": ["pthread"],
      "${cfg debug}": {
        "export-symbols": true
      },
      "cflags": ["-D_POSIX_C_SOURCE=200809L"],
      "${cfg sanitize}": {
        "export-symbols": true
      }
    }
  },
  "bundle": {
    "repositories": {
      "sireflect": "https://github.com/suleymanlaarabi/sireflect",
      "sijson": "https://github.com/suleymanlaarabi/sijson",
      "sihttp": "https://github.com/suleymanlaarabi/sihttp",
      "sicore":  "https://github.com/suleymanlaarabi/sicore"
    }
  }
}
