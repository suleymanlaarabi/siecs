---
import { Tabs, TabItem } from '@astrojs/starlight/components';

interface Props {
  code: string;
  language?: string;
}

const { code, language = 'c' } = Astro.props;
const displayCode = typeof code === 'string' && code.startsWith('"')
  ? JSON.parse(code)
  : code;
const cppCode = `#include <siecs.h>\n\n${displayCode}`;
---

<Tabs syncKey="language">
  <TabItem label="C">
    <pre><code class={`language-${language}`}>{displayCode}</code></pre>
  </TabItem>
  <TabItem label="C++">
    <pre><code class="language-cpp">{cppCode}</code></pre>
  </TabItem>
</Tabs>
