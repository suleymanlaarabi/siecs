{
  "id": "siecs.test",
  "type": "application",
  "value": {
    "public": false,
    "clangd": true,
    "use": ["siecs"]
  },
  "lang.c": {
    "c-standard": "c99",
    "include": ["../src"]
  },
  "test": {
    "testsuites": [
      {
        "id": "entity",
        "testcases": ["create", "with"]
      },
      {
        "id": "childof",
        "testcases": ["kill_parent"]
      },
      {
        "id": "system",
        "testcases": ["run", "phase_order", "after_order", "enable"]
      },
      {
        "id": "string",
        "testcases": ["init", "append", "trim", "starts_ends_with"]
      },
      {
        "id": "lexer",
        "testcases": [
          "single_char_tokens",
          "two_char_tokens",
          "keywords_and_identifiers",
          "numbers",
          "strings",
          "unknown"
        ]
      }
    ]
  }
}
