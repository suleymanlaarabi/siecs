{
  "id": "siecs.test",
  "type": "application",
  "value": {
    "public": false,
    "clangd": true,
    "use": ["siecs", "sijson"]
  },
  "lang.c": {
    "c-standard": "c23",
    "include": ["../src"]
  },
  "test": {
    "testsuites": [
      {
        "id": "entity",
        "testcases": ["create", "with"]
      },
      {
        "id": "component",
        "testcases": ["reflection", "on_add"]
      },
      {
        "id": "childof",
        "testcases": ["kill_parent"]
      },
      {
        "id": "query",
        "testcases": [
          "terms_field_order",
          "out_term_matches_and_returns_field",
          "not_excludes_tables"
        ]
      },
      {
        "id": "system",
        "testcases": ["run", "phase_order", "after_order", "enable"]
      },
      {
        "id": "observer",
        "testcases": ["enable"]
      },
      {
        "id": "module",
        "testcases": [
          "import_registers_runtime",
          "enable",
          "disabled_import",
          "double_import_is_noop",
          "same_module_two_worlds"
        ]
      },
      {
        "id": "string",
        "testcases": ["init", "append", "trim", "starts_ends_with"]
      },
      {
        "id": "lexer",
        "testcases": [
          "single_char_tokens",
          "two_char_tokens",
          "keywords_and_identifiers",
          "numbers",
          "strings",
          "unknown"
        ]
      }
    ]
  }
}
