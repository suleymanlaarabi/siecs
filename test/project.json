{
  "id": "siecs.test",
  "type": "application",
  "value": {
    "public": false,
    "clangd": true,
    "use": ["siecs", "sijson"]
  },
  "lang.c": {
    "c-standard": "c23",
    "include": ["../src"]
  },
  "test": {
    "testsuites": [
      {
        "id": "entity",
        "testcases": ["create", "with"]
      },
      {
        "id": "component",
        "testcases": ["reflection", "on_add"]
      },
      {
        "id": "resource",
        "testcases": [
          "set_get",
          "try_get_missing",
          "remove",
          "replace",
          "from_system_c",
          "hooks",
          "does_not_consume_component_ids"
        ]
      },
      {
        "id": "childof",
        "testcases": [
          "kill_parent",
          "relation_without_cascade_keeps_related_alive",
          "relation_remove_updates_source"
        ]
      },
      {
        "id": "query",
        "testcases": [
          "terms_field_order",
          "out_term_matches_and_returns_field",
          "not_excludes_tables",
          "excludes_disabled_by_default",
          "can_include_disabled_explicitly"
        ]
      },
      {
        "id": "system",
        "testcases": [
          "run",
          "phase_order",
          "start_phases_run_once",
          "after_order",
          "enable",
          "without_query_runs_once",
          "callback_can_advance_iterator",
          "skips_disabled_by_default",
          "can_run_on_disabled_when_requested"
        ]
      },
      {
        "id": "observer",
        "testcases": [
          "enable",
          "skips_disabled_by_default",
          "can_match_disabled_when_requested"
        ]
      },
      {
        "id": "module",
        "testcases": [
          "import_registers_runtime",
          "enable",
          "disabled_import",
          "double_import_is_noop",
          "reimport_after_world_fini"
        ]
      },
      {
        "id": "string",
        "testcases": ["init", "append", "trim", "starts_ends_with"]
      },
      {
        "id": "lexer",
        "testcases": [
          "single_char_tokens",
          "two_char_tokens",
          "keywords_and_identifiers",
          "numbers",
          "strings",
          "unknown"
        ]
      }
    ]
  }
}
